# ==========================================================================
# MemMCP configuration. Copy to `.env` and edit. Every value has a safe
# default, so the server runs fully offline with an empty file.
# ==========================================================================

# ---- Storage ----
# Directory where memories, indexes and audit logs are persisted.
MEMMCP_DATA_DIR=./.memmcp_data

# ---- Embeddings ----
# Provider: "hash" (offline, deterministic, no deps), "sentence-transformers"
# (local model, needs `pip install memmcp[local-embed]`), or "openai".
MEMMCP_EMBEDDING_PROVIDER=hash
MEMMCP_EMBEDDING_DIM=384
# Model name used by sentence-transformers / openai providers.
MEMMCP_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Vector store ----
# Backend: "numpy" (offline, persistent JSON) or "chroma"
# (needs `pip install memmcp[chroma]`).
MEMMCP_VECTOR_BACKEND=numpy

# ---- Fact extraction ----
# Provider: "rule" (offline heuristics), "openai", or "anthropic".
MEMMCP_EXTRACTION_PROVIDER=rule
MEMMCP_EXTRACTION_MODEL=gpt-4o-mini

# ---- Retrieval ranking weights (must sum to ~1.0) ----
MEMMCP_WEIGHT_RELEVANCE=0.6
MEMMCP_WEIGHT_RECENCY=0.25
MEMMCP_WEIGHT_IMPORTANCE=0.15
# Recency half-life in days: how fast a memory's recency score decays.
MEMMCP_RECENCY_HALFLIFE_DAYS=30

# ---- Distillation ----
# Cosine similarity at/above which two facts are treated as duplicates.
MEMMCP_DEDUP_THRESHOLD=0.92
# Cosine similarity above which two facts on the same key may conflict.
MEMMCP_CONFLICT_THRESHOLD=0.60

# ---- Privacy ----
# "block" = refuse to store PII, "redact" = mask it, "flag" = store + tag, "off".
MEMMCP_PII_POLICY=redact

# ---- API keys (only needed for openai / anthropic providers) ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
